<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="createBookDialog"
            fx:controller="com.github.desktop.demo.controller.CreateBookView"
            prefHeight="400.0" prefWidth="600.0">

    <VBox prefHeight="400.0" prefWidth="600.0" spacing="8.0">

        <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
        </padding>

        <HBox>
            <Label text="Title" prefWidth="100"/>
            <TextField fx:id="titleTextField" prefWidth="400"/>
        </HBox>

        <HBox>
            <Label text="Description" prefWidth="130"/>
            <TextArea fx:id="descriptionTextArea"/>
        </HBox>

        <HBox>
            <Label text="Author" prefWidth="100"/>
            <TextField fx:id="authorTextField" prefWidth="300"/>
        </HBox>

        <HBox>
            <Label text="Genre" prefWidth="100"/>
            <TextField fx:id="genreTextField" prefWidth="300"/>
        </HBox>

        <HBox>
            <Label text="Publish Year" prefWidth="100"/>
            <TextField fx:id="publishYearTextField" prefWidth="80"/>
        </HBox>

        <Separator prefWidth="600.0"/>

        <HBox spacing="8.0" alignment="CENTER_RIGHT">
            <Button mnemonicParsing="false" onAction="#onSubmitButton" text="OK"/>
            <Button mnemonicParsing="false" onAction="#onCancelButton" text="Cancel"/>
        </HBox>

    </VBox>

</AnchorPane>
