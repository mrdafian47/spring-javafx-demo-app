<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.github.desktop.demo.controller.ListBookView"
            prefHeight="400.0"
            prefWidth="400.0">

    <VBox>

        <TableView fx:id="bookTableView" layoutX="-1.0" layoutY="-1.0" prefHeight="400.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="#"/>
                <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Title"/>
                <TableColumn fx:id="authorColumn" prefWidth="150.0" text="Author"/>
                <TableColumn fx:id="editColumn" prefWidth="100.0" text="Edit"/>
                <TableColumn fx:id="deleteColumn" prefWidth="100.0" text="Delete"/>
            </columns>
        </TableView>

        <HBox spacing="8.0" layoutY="400.0" alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Button mnemonicParsing="false" onAction="#onCreateButton" text="Create New"/>
        </HBox>

    </VBox>

</AnchorPane>
