<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.web.WebView?>
<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.desktop.demo.controller.PerbarindoWebView"
      fx:id="perbarindoContainer">

    <BorderPane prefWidth="1400.0" prefHeight="900.0">

        <top>
            <HBox spacing="16.0">
                <padding>
                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                </padding>
                <Button text="Reload" onAction="#onReloadWeb"/>
            </HBox>
        </top>

        <center>
            <WebView fx:id="perbarindoWebView"/>
        </center>

    </BorderPane>

</Pane>
