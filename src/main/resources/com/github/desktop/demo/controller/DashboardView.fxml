<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<SplitPane
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/23.0.1"
        dividerPositions="0.29797979797979796" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
        minWidth="-Infinity" prefHeight="400.0" prefWidth="875.0"
        fx:controller="com.github.desktop.demo.controller.DashboardView">

    <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0">
        <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
        </padding>
        <Button fx:id="buttonSignIn" text="Sign In"/>
        <Button fx:id="buttonSignUp" text="Sign Up"/>
        <Separator prefWidth="200.0"/>
        <Button fx:id="buttonDataUser" text="Data User"/>
        <Button fx:id="buttonDataBook" text="Data Book" onAction="#onNavigateToBook"/>
        <Button fx:id="buttonDataWeb" text="Data Web" onAction="#onNavigateToWeb"/>
        <Separator prefWidth="200.0"/>
        <Button fx:id="buttonSignOut" text="Sign Out"/>
    </VBox>

    <ScrollPane prefHeight="200.0" prefWidth="400.0">
        <VBox fx:id="container" prefHeight="200.0" prefWidth="400.0"/>
    </ScrollPane>

</SplitPane>
